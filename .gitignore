# ==============================================================================
# PeerSpace Comprehensive Git Ignore Rules
# ==============================================================================

# Secrets and Environment Variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/

# Python Compilation & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
bin/
include/
lib/

# Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Quality & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# IDEs & Text Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# Operating System & File Managers
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*Zone.Identifier

# Local Debugging Logs
*.log
logs/
tmp/
temp/
