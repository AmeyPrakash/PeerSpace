# ==============================================================================
# PeerSpace Environment Configuration Template
# Copy this file to '.env' and populate your credentials:
#   cp .env.example .env
# ==============================================================================

# REQUIRED: Groq LLM API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# REQUIRED: Campus Counselor Portal Passkey
# Must be set to a strong, unique value for your deployment
# Minimum 6 characters, can contain any characters
# Change this to a secure passkey for your institution
COUNSELOR_PASSKEY=your_secure_passkey_here

# Optional: Host & Port Configuration
HOST=0.0.0.0
PORT=8000

# Optional: LLM Model Override (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
